{%- comment -%}
  Artemano — « Prendre rendez-vous en magasin » sur les fiches produit.
  Remplace « Acheter maintenant » à partir du prix choisi dans Réglages du thème › Artemano.

  part: 'check'  → affiche « 1 » si le produit est admissible (sert aux conditions)
  part: 'button' → lien vers la page /pages/rendez-vous avec la pièce (?produit=…&variante=…)
  part: 'dialog' → petite phrase sous les boutons + mise à jour du modèle choisi dans le lien
                   (nom gardé pour ne pas toucher au bloc d'achat)

  La page à part permet de mesurer les visites (demande de Cedrick). Le formulaire est dans
  sections/artemano-rdv-page.liquid.
{%- endcomment -%}

{%- liquid
  assign rdv_min = settings.artemano_rdv_min_price | default: 500 | times: 100
  assign rdv_ok = false
  if settings.artemano_rdv_enabled and product and product.gift_card? == false and product.price_max >= rdv_min
    assign rdv_ok = true
  endif
-%}

{%- if part == 'check' -%}
  {%- if rdv_ok -%}1{%- endif -%}
{%- elsif rdv_ok and part == 'button' -%}
  {%- liquid
    assign rdv_page = pages['rendez-vous'].url | default: '/pages/rendez-vous'
    assign rdv_href = rdv_page | append: '?produit=' | append: product.handle
    assign variant = product.selected_or_first_available_variant
    unless product.has_only_default_variant
      assign rdv_href = rdv_href | append: '&variante=' | append: variant.id
    endunless
    assign rdv_label = 'artemano.rdv.label' | t
  -%}
  <a
    href="{% render 'artemano-url', url: rdv_href %}"
    class="button button-secondary artemano-rdv__open"
    data-artemano-rdv-link
  >
    {{- settings.artemano_rdv_label | default: rdv_label -}}
  </a>
{%- elsif rdv_ok and part == 'dialog' -%}
  {%- assign rdv_hint = 'artemano.rdv.hint' | t -%}
  <p class="artemano-rdv__hint">
    {{- settings.artemano_rdv_hint | default: rdv_hint -}}
  </p>

  <script>
    // Le modèle choisi (couleur, format…) suit dans le lien au moment du clic
    (function () {
      if (window.artemanoRdvLinkReady) return;
      window.artemanoRdvLinkReady = true;
      document.addEventListener('click', function (event) {
        var link = event.target.closest('[data-artemano-rdv-link]');
        if (!link) return;
        var input = document.querySelector('form[data-type="add-to-cart-form"] input[name="id"]');
        if (!input || !input.value) return;
        var url = new URL(link.href, location.origin);
        if (url.searchParams.has('variante')) {
          url.searchParams.set('variante', input.value);
          link.href = url.toString();
        }
      });
    })();
  </script>
{%- endif -%}
