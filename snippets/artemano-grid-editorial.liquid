{%- doc -%}
  Tuile éditoriale insérée dans la grille des collections (réglages du thème, section « Artemano »).
{%- enddoc -%}
<a
  href="{% render 'artemano-url', url: settings.artemano_tile_link, fallback: '#essences' %}"
  class="artemano-grid-tile{% if settings.artemano_tile_image != blank %} has-image{% endif %}"
>
  {%- if settings.artemano_tile_image != blank -%}
    {{
      settings.artemano_tile_image
      | image_url: width: 1400
      | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: '', class: 'artemano-grid-tile__image'
    }}
  {%- endif -%}
  <span class="artemano-grid-tile__content">
    <span class="artemano-eyebrow artemano-grid-tile__eyebrow">{{ settings.artemano_tile_eyebrow }}</span>
    <span class="artemano-grid-tile__title">{{ settings.artemano_tile_title }}</span>
    {%- if settings.artemano_tile_text != blank -%}
      <span class="artemano-grid-tile__text">{{ settings.artemano_tile_text }}</span>
    {%- endif -%}
    {%- if settings.artemano_tile_link_label != blank -%}
      <span class="artemano-grid-tile__link">{{ settings.artemano_tile_link_label }}</span>
    {%- endif -%}
  </span>
</a>

{% stylesheet %}
  .artemano-grid-tile-item {
    grid-column: span 2;
  }

  .artemano-grid-tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-height: 26rem;
    padding: 2.5rem;
    overflow: hidden;
    background: linear-gradient(160deg, #6b4a32 0%, var(--artemano-walnut, #4a3426) 55%, #3a281d 100%);
    color: var(--artemano-cream, #f7f3ec);
    text-decoration: none;
  }

  .artemano-grid-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artemano-grid-tile.has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(43 36 32 / 0) 30%, rgb(43 36 32 / 0.75) 100%);
  }

  .artemano-grid-tile__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 30rem;
  }

  .artemano-grid-tile__eyebrow {
    color: #d9b98c;
  }

  .artemano-grid-tile__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.875rem, 3vw, 2.75rem);
    line-height: 1.1;
  }

  .artemano-grid-tile__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .artemano-grid-tile__link {
    margin-top: 0.5rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .artemano-grid-tile-item {
      grid-column: 1 / -1;
    }

    .artemano-grid-tile {
      min-height: 20rem;
      padding: 1.5rem;
    }
  }
{% endstylesheet %}
