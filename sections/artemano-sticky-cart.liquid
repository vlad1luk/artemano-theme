{%- comment -%}
  Artemano — barre « Ajouter au panier » collante sur mobile.
  Elle apparaît quand le bouton principal sort de l'écran et clique sur ce bouton (même variante, même quantité).
{%- endcomment -%}

<artemano-sticky-cart class="artemano-sticky" hidden>
  <div class="artemano-sticky__price">
    <span class="artemano-sticky__label">
      {%- if product.price_varies -%}À partir de{%- else -%}Prix{%- endif -%}
    </span>
    <strong>{{ product.price_min | money_without_trailing_zeros | strip_html }}</strong>
  </div>
  <button type="button" class="artemano-btn artemano-btn--dark artemano-sticky__button">
    {%- if product.available -%}Ajouter au panier{%- else -%}Bientôt disponible{%- endif -%}
  </button>
</artemano-sticky-cart>

<script>
  if (!customElements.get('artemano-sticky-cart')) {
    customElements.define(
      'artemano-sticky-cart',
      class extends HTMLElement {
        connectedCallback() {
          this.mainButton = document.querySelector(
            'form[action*="/cart/add"] button[type="submit"], form[action*="/cart/add"] [name="add"]'
          );
          if (!this.mainButton) return;

          this.querySelector('button').addEventListener('click', () => {
            if (this.mainButton.disabled) {
              this.mainButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
              return;
            }
            this.mainButton.click();
          });

          const mobile = window.matchMedia('(max-width: 749px)');
          this.observer = new IntersectionObserver(([entry]) => {
            this.hidden = !mobile.matches || entry.isIntersecting || entry.boundingClientRect.top > 0;
          });
          this.observer.observe(this.mainButton);
        }

        disconnectedCallback() {
          this.observer?.disconnect();
        }
      }
    );
  }
</script>

{% stylesheet %}
  .artemano-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: var(--artemano-white, #fff);
    border-top: 1px solid var(--artemano-line, #e2d9cc);
    box-shadow: 0 -8px 24px rgb(43 36 32 / 0.06);
  }

  .artemano-sticky[hidden] {
    display: none;
  }

  .artemano-sticky__price {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    color: var(--artemano-ink, #2b2420);
  }

  .artemano-sticky__label {
    font-size: 0.6875rem;
    color: var(--artemano-ink-muted, #7d7066);
  }

  .artemano-sticky__price strong {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .artemano-sticky__button {
    flex: 1;
    max-width: 14rem;
  }

  @media screen and (min-width: 750px) {
    .artemano-sticky {
      display: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barre d'achat mobile",
  "tag": "div",
  "class": "artemano-sticky-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [{ "name": "Barre d'achat mobile" }]
}
{% endschema %}
