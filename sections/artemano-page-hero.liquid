{%- comment -%}
  Artemano — en-tête de page (Notre histoire, Nous joindre, Notre magasin, FAQ…).
  Avec image : bandeau pleine largeur ; sans image : bandeau crème sobre.
{%- endcomment -%}

{%- liquid
  assign title = section.settings.title | default: page.title
  assign image = section.settings.image
-%}

<div
  class="artemano-page-hero{% if image != blank %} has-image{% endif %}"
  style="--page-hero-height: {{ section.settings.height }}rem;"
>
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '800, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'artemano-page-hero__image',
        alt: image.alt | escape
    }}
  {%- endif -%}
  <div class="artemano-page-hero__inner artemano-container">
    <div class="artemano-page-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="artemano-eyebrow artemano-page-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="artemano-page-hero__title">{{ title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <div class="artemano-page-hero__subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
        <div class="artemano-page-hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '#' }}" class="artemano-btn artemano-btn--{% if image != blank %}light{% else %}dark{% endif %}">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a href="{{ section.settings.button2_link | default: '#' }}" class="artemano-btn artemano-btn--{% if image != blank %}ghost-light{% else %}outline{% endif %}">
              {{- section.settings.button2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .artemano-page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    background: var(--artemano-cream, #f7f3ec);
    border-bottom: 1px solid var(--artemano-line, #e2d9cc);
  }

  .artemano-page-hero.has-image {
    min-height: var(--page-hero-height);
    margin-inline: 4px;
    border-bottom: 0;
    overflow: hidden;
    background: var(--artemano-walnut, #4a3426);
    color: var(--artemano-cream, #f7f3ec);
  }

  .artemano-page-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artemano-page-hero.has-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(43 36 32 / 0.7) 0%, rgb(43 36 32 / 0.15) 60%, rgb(43 36 32 / 0) 100%);
  }

  .artemano-page-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 4rem 3.5rem;
  }

  .artemano-page-hero__text {
    max-width: 44rem;
  }

  .artemano-page-hero__eyebrow {
    margin: 0 0 1rem;
  }

  .artemano-page-hero.has-image .artemano-page-hero__eyebrow {
    color: #d9b98c;
  }

  .artemano-page-hero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.02;
    color: inherit;
  }

  .artemano-page-hero:not(.has-image) .artemano-page-hero__title {
    color: var(--artemano-ink, #2b2420);
  }

  .artemano-page-hero__subtitle {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.92;
  }

  .artemano-page-hero__subtitle p {
    margin: 0;
  }

  .artemano-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .artemano-page-hero:not(.has-image) .artemano-page-hero__subtitle {
    color: var(--artemano-ink-soft, #5a4e45);
  }

  @media screen and (max-width: 749px) {
    .artemano-page-hero.has-image {
      margin-inline: 0;
      min-height: calc(var(--page-hero-height) * 0.7);
    }

    .artemano-page-hero__inner {
      padding-block: 2.5rem 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "En-tête de page",
  "tag": "section",
  "class": "artemano-page-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Étiquette" },
    { "type": "text", "id": "title", "label": "Titre", "info": "Laisser vide pour utiliser le titre de la page." },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Bouton principal" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Bouton secondaire" },
    { "type": "url", "id": "button2_link", "label": "Lien du bouton secondaire" },
    { "type": "range", "id": "height", "label": "Hauteur avec image", "min": 20, "max": 44, "step": 2, "unit": "rem", "default": 32 }
  ],
  "presets": [{ "name": "En-tête de page" }]
}
{% endschema %}
