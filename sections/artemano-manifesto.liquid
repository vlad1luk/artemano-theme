{%- comment -%}
  Artemano — manifeste de la maison : symbole papillon doré, grande citation,
  signature « maison fondée en 2002 » et lien vers l'histoire.
{%- endcomment -%}

<div class="artemano-manifesto artemano-manifesto--{{ section.settings.background }}">
  <div class="artemano-container artemano-manifesto__inner">
    {%- if section.settings.show_mark -%}
      <span class="artemano-manifesto__mark" aria-hidden="true">
        {%- render 'artemano-logo', variant: 'mark' -%}
      </span>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="artemano-eyebrow artemano-manifesto__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <blockquote class="artemano-manifesto__quote" data-lx-words>
        <p>{{ section.settings.quote }}</p>
      </blockquote>
    {%- endif -%}

    {%- if section.settings.signature != blank -%}
      <p class="artemano-manifesto__signature">{{ section.settings.signature }}</p>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <a href="{% render 'artemano-url', url: section.settings.link %}" class="artemano-text-link artemano-manifesto__link">
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .artemano-manifesto {
    --manifesto-gold: var(--artemano-gold, #a8834f);
    padding-block: 7rem 7.5rem;
    text-align: center;
  }

  .artemano-manifesto--cream {
    background:
      radial-gradient(ellipse 65% 70% at 50% 0%, #fcfaf6 0%, rgb(252 250 246 / 0) 70%),
      var(--artemano-cream, #f7f3ec);
    color: var(--artemano-ink, #2b2420);
  }

  .artemano-manifesto--walnut {
    --manifesto-gold: var(--artemano-gold-light, #d9b98c);
    background-color: var(--artemano-walnut, #4a3426);
    color: var(--artemano-cream, #f7f3ec);
  }

  .artemano-manifesto__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .artemano-manifesto__mark {
    display: block;
    width: 3.25rem;
    margin-bottom: 2rem;
    color: var(--manifesto-gold);
  }

  .artemano-manifesto__mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .artemano-manifesto__eyebrow {
    margin: 0 0 1.75rem;
    color: var(--manifesto-gold);
  }

  .artemano-manifesto__quote {
    max-width: 58rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .artemano-manifesto__quote p {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 1.16;
    letter-spacing: -0.005em;
    color: inherit;
    text-wrap: balance;
  }

  .artemano-manifesto__signature {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--artemano-ink-soft, #5a4e45);
  }

  .artemano-manifesto--walnut .artemano-manifesto__signature {
    color: rgb(247 243 236 / 0.78);
  }

  .artemano-manifesto__signature::before,
  .artemano-manifesto__signature::after {
    content: '';
    width: 3rem;
    height: 1px;
    background: var(--manifesto-gold);
    opacity: 0.7;
  }

  a.artemano-manifesto__link {
    margin-top: 2.25rem;
  }

  @media screen and (max-width: 749px) {
    .artemano-manifesto {
      padding-block: 4.5rem 5rem;
    }

    .artemano-manifesto__mark {
      width: 2.75rem;
      margin-bottom: 1.5rem;
    }

    .artemano-manifesto__signature {
      gap: 0.875rem;
      letter-spacing: 0.18em;
    }

    .artemano-manifesto__signature::before,
    .artemano-manifesto__signature::after {
      width: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Manifeste de la maison",
  "tag": "section",
  "class": "artemano-manifesto-section",
  "settings": [
    { "type": "checkbox", "id": "show_mark", "label": "Afficher le papillon", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Maison Artemano" },
    { "type": "textarea", "id": "quote", "label": "Citation", "default": "Nature defines who we are, and who we are is defined by nature." },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Longueuil · Since 2002" },
    { "type": "text", "id": "link_label", "label": "Lien : texte", "default": "Our story" },
    { "type": "url", "id": "link", "label": "Lien : adresse" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "walnut", "label": "Noyer" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Manifeste de la maison" }]
}
{% endschema %}
