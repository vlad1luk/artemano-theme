{%- comment -%}
  Artemano — sous-menu visible sous la navigation par pièce.
  Affiche les sous-catégories de la pièce active (ou de la pièce par défaut sur les autres pages).
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign active_link = nil

  for link in menu.links
    if link.active or link.child_active
      assign active_link = link
      break
    endif
  endfor

  if active_link == nil
    assign default_index = section.settings.default_index | minus: 1
    assign active_link = menu.links[default_index]
  endif
-%}

{%- if active_link != nil -%}
  <artemano-subnav
    class="artemano-subnav"
    style="--subnav-bg: {{ section.settings.background_color }};"
  >
    <div class="artemano-subnav__inner artemano-container">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <nav
            class="artemano-subnav__group"
            aria-label="{{ link.title | escape }}"
            data-subnav-url="{{ link.url }}"
            {% if link.url == active_link.url %}
              data-default
            {% else %}
              hidden
            {% endif %}
          >
            <ul class="artemano-subnav__list list-unstyled" role="list">
              {%- for child in link.links -%}
                <li>
                  <a
                    href="{{ child.url }}"
                    class="artemano-subnav__link"
                    {% if child.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- child.title -}}
                  </a>
                </li>
              {%- endfor -%}
              <li>
                <a href="{{ link.url }}" class="artemano-subnav__link artemano-subnav__link--all">
                  {{- section.settings.all_label | default: 'Tout voir' }} →
                </a>
              </li>
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </artemano-subnav>

  <script>
    /* Survol d'une pièce dans la navigation : on affiche ses sous-catégories dans la barre blanche
       au lieu du menu déroulant d'Horizon (désactivé sur ordinateur). */
    if (!customElements.get('artemano-subnav')) {
      customElements.define(
        'artemano-subnav',
        class extends HTMLElement {
          connectedCallback() {
            this.groups = [...this.querySelectorAll('[data-subnav-url]')];
            this.defaultGroup = this.querySelector('[data-default]');
            this.header = document.querySelector('#header-component') || document.querySelector('.header');
            if (!this.header) return;
            this.topLinks = [...this.header.querySelectorAll('.header__row--bottom .menu-list__link')];

            this.topLinks.forEach((link) => {
              link.addEventListener('mouseenter', () => this.show(link));
              link.addEventListener('focus', () => this.show(link));
            });

            /* Quitter l'en-tête et le sous-menu ramène la pièce par défaut */
            this.wrapper = this.closest('.shopify-section') || this;
            this.leaveTimer = null;
            const leave = () => {
              clearTimeout(this.leaveTimer);
              this.leaveTimer = setTimeout(() => this.reset(), 250);
            };
            const enter = () => clearTimeout(this.leaveTimer);
            [this.header, this.wrapper].forEach((el) => {
              el.addEventListener('mouseleave', leave);
              el.addEventListener('mouseenter', enter);
            });

            this.reset();
          }

          path(url) {
            try {
              return new URL(url, location.origin).pathname.replace(/^\/(fr|en)(?=\/)/, '');
            } catch (e) {
              return url;
            }
          }

          show(link) {
            const target = this.path(link.getAttribute('href') || '');
            const group = this.groups.find((g) => this.path(g.dataset.subnavUrl) === target);
            if (!group) return;
            this.activate(group);
          }

          reset() {
            if (this.defaultGroup) this.activate(this.defaultGroup);
          }

          activate(group) {
            this.groups.forEach((g) => (g.hidden = g !== group));
            const target = this.path(group.dataset.subnavUrl);
            this.topLinks.forEach((l) => {
              l.toggleAttribute('data-artemano-current', this.path(l.getAttribute('href') || '') === target);
            });
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .artemano-subnav {
    display: block;
    background: var(--subnav-bg);
    border-block: 1px solid var(--artemano-line, #e2d9cc);
  }

  .artemano-subnav__group[hidden] {
    display: none;
  }

  .artemano-subnav__list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
    margin: 0;
    padding-block: 1rem;
  }

  .artemano-subnav__link {
    color: var(--artemano-ink-soft, #5a4e45);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .artemano-subnav__link:hover,
  .artemano-subnav__link[aria-current] {
    color: var(--artemano-ink, #2b2420);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .artemano-subnav__link--all {
    color: var(--artemano-ink, #2b2420);
    font-weight: 500;
  }

  @media screen and (max-width: 989px) {
    .artemano-subnav__list {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 1.5rem;
      padding-block: 0.75rem;
    }

    .artemano-subnav__list::-webkit-scrollbar {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sous-menu par pièce",
  "tag": "div",
  "class": "artemano-subnav-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "default_index",
      "label": "Pièce affichée par défaut",
      "info": "Position dans le menu (1 = première pièce) quand aucune pièce n'est active.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Texte du lien « tout voir »",
      "default": "Tout voir"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Sous-menu par pièce"
    }
  ]
}
{% endschema %}
