{%- comment -%}
  Artemano — image et texte côte à côte (récit, savoir-faire, atelier…).
  Sans image : un fond bois remplace la photo, pour que la mise en page tienne avant les vraies photos.
{%- endcomment -%}

{%- assign image = section.settings.image -%}

<div class="artemano-split artemano-split--{{ section.settings.background }}{% if section.settings.image_side == 'right' %} artemano-split--reverse{% endif %}">
  <div class="artemano-split__inner artemano-container">
    <div class="artemano-split__media{% if image == blank %} is-placeholder{% endif %}">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            class: 'artemano-split__image',
            alt: image.alt | escape
        }}
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <p class="artemano-split__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>

    <div class="artemano-split__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="artemano-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="artemano-split__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="artemano-rte artemano-split__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote class="artemano-split__quote">
          <p>{{ section.settings.quote }}</p>
          {%- if section.settings.quote_author != blank -%}
            <cite>{{ section.settings.quote_author }}</cite>
          {%- endif -%}
        </blockquote>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="artemano-btn artemano-btn--{% if section.settings.background == 'walnut' %}light{% else %}dark{% endif %}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .artemano-split {
    padding-block: 5rem;
  }

  .artemano-split--cream {
    background: var(--artemano-cream, #f7f3ec);
  }

  .artemano-split--white {
    background: #fff;
  }

  .artemano-split--walnut {
    background: var(--artemano-walnut, #4a3426);
    color: var(--artemano-cream, #f7f3ec);
  }

  .artemano-split__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .artemano-split--reverse .artemano-split__media {
    order: 2;
  }

  .artemano-split__media {
    position: relative;
    margin: 0;
  }

  .artemano-split__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }

  .artemano-split__media.is-placeholder::before {
    content: '';
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
    background:
      repeating-linear-gradient(100deg, rgb(255 255 255 / 0.04) 0 2px, transparent 2px 14px),
      linear-gradient(140deg, #3a281d 0%, var(--artemano-walnut-soft, #6e4b2f) 55%, #a07c5b 100%);
  }

  .artemano-split__caption {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    font-style: italic;
    opacity: 0.75;
  }

  .artemano-split__text .artemano-eyebrow {
    margin: 0 0 1rem;
  }

  .artemano-split--walnut .artemano-eyebrow {
    color: #d9b98c;
  }

  .artemano-split__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.08;
    color: inherit;
  }

  .artemano-split:not(.artemano-split--walnut) .artemano-split__title {
    color: var(--artemano-ink, #2b2420);
  }

  .artemano-split--walnut .artemano-rte {
    color: rgb(247 243 236 / 0.88);
  }

  .artemano-split__quote {
    margin: 2rem 0 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--artemano-sage, #5e6b4f);
  }

  .artemano-split__quote p {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.4;
  }

  .artemano-split__quote cite {
    display: block;
    margin-top: 0.75rem;
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .artemano-split__text .artemano-btn {
    margin-top: 2rem;
  }

  @media screen and (max-width: 989px) {
    .artemano-split {
      padding-block: 3rem;
    }

    .artemano-split__inner {
      grid-template-columns: 1fr;
    }

    .artemano-split--reverse .artemano-split__media {
      order: 0;
    }

    .artemano-split__image,
    .artemano-split__media.is-placeholder::before {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image et texte",
  "tag": "section",
  "class": "artemano-split-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Légende de l'image" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Position de l'image",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "white", "label": "Blanc" },
        { "value": "walnut", "label": "Noyer" }
      ],
      "default": "cream"
    },
    { "type": "text", "id": "eyebrow", "label": "Étiquette" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "textarea", "id": "quote", "label": "Citation" },
    { "type": "text", "id": "quote_author", "label": "Auteur de la citation" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Image et texte" }]
}
{% endschema %}
